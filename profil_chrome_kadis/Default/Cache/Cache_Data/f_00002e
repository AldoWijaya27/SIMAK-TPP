      function openSheet() {
        if (sheet) sheet.classList.remove("translate-y-full");
        if (overlay) overlay.classList.remove("hidden");
      }
      function closeSheet() {
        if (sheet) sheet.classList.add("translate-y-full");
        if (overlay) overlay.classList.add("hidden");
      }
      var logoBtn = document.getElementById("mobile-logo-btn");
      var logoBtnLogin = document.getElementById("mobile-logo-btn-login");
      var sheetClose = document.getElementById("mobile-sheet-close");
      if (logoBtn) logoBtn.addEventListener("click", openSheet);
      if (logoBtnLogin) logoBtnLogin.addEventListener("click", openSheet);
      var centerLogo = document.getElementById("mobile-center-logo");
      if (centerLogo) centerLogo.addEventListener("click", openSheet);
      if (sheetClose) sheetClose.addEventListener("click", closeSheet);
      if (overlay) overlay.addEventListener("click", closeSheet);

      // Tutup sheet saat kartu layanan di-tap
      ["btn-layanan-seleksi-mobile","btn-layanan-individu-mobile","btn-layanan-instansi-mobile",
       "btn-layanan-bkn-mobile","btn-layanan-guest-mobile"].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.addEventListener("click", closeSheet);
      });

      // Bottom nav Chat → trigger MiniChat toggle
      var navChat = document.getElementById("mobile-nav-chat");
      if (navChat) navChat.addEventListener("click", function() {
        var toggle = document.getElementById("mini-chat-toggle");
        if (toggle) toggle.click();
      });

      // Bottom nav Masuk
      var navMasuk = document.getElementById("mobile-nav-masuk");
      if (navMasuk) navMasuk.addEventListener("click", function() {
        var loginBtn = document.getElementById("btn-layanan-login-mobile");
        if (loginBtn) loginBtn.click();
      });

      // Bottom nav Akun → buka modal dengan animasi
      var akunModal = document.getElementById("mobile-akun-modal");
      var akunOverlay = document.getElementById("mobile-akun-overlay");
      var akunSheet = document.getElementById("mobile-akun-sheet");
      function openAkunModal() {
        if (!akunModal) return;
        akunModal.classList.remove("hidden");
        requestAnimationFrame(function() {
          if (akunSheet) akunSheet.classList.remove("translate-y-full");
          if (akunOverlay) akunOverlay.classList.remove("opacity-0");
        });
      }
      function closeAkunModal() {
        if (akunSheet) akunSheet.classList.add("translate-y-full");
        if (akunOverlay) akunOverlay.classList.add("opacity-0");
        setTimeout(function() { if (akunModal) akunModal.classList.add("hidden"); }, 300);
      }
      var navAkun = document.getElementById("mobile-nav-akun");
      if (navAkun) navAkun.addEventListener("click", openAkunModal);
      var userAvatar = document.getElementById("mobile-user-avatar");
      if (userAvatar) userAvatar.addEventListener("click", openAkunModal);
      if (akunOverlay) akunOverlay.addEventListener("click", closeAkunModal);
      var btnBatal = document.getElementById("akun-modal-batal");
      if (btnBatal) btnBatal.addEventListener("click", closeAkunModal);

      // Modal: Keluar
      var btnKeluar = document.getElementById("akun-modal-keluar");
      if (btnKeluar) btnKeluar.addEventListener("click", function() {
        closeAkunModal();
        var logoutBtn = document.getElementById("logout");
        if (logoutBtn) logoutBtn.click();
      });

      // Modal: Aktifkan Notifikasi → trigger komponen Notifikasi
      var notifStatus = document.getElementById("akun-notif-status");
      function updateNotifStatus() {
        if (!("Notification" in window)) return;
        if (Notification.permission === "granted") {
          if (notifStatus) notifStatus.textContent = "✓ Notifikasi sudah aktif";
        } else if (Notification.permission === "denied") {
          if (notifStatus) notifStatus.textContent = "Notifikasi diblokir di browser";
        }
      }
      updateNotifStatus();
      var btnNotif = document.getElementById("akun-modal-notif");
      if (btnNotif) btnNotif.addEventListener("click", function() {
        var bellBtn = document.getElementById("notif-bell-btn");
        if (bellBtn) bellBtn.click();
      });
    })();
