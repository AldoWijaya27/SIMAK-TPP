  const overlay   = document.getElementById("pencarian-overlay");
  const backdrop  = document.getElementById("pencarian-backdrop");
  const card      = document.getElementById("pencarian-card");
  const input     = document.getElementById("pencarian-input");
  const resultsList = document.getElementById("pencarian-results");
  const emptyState  = document.getElementById("pencarian-empty");

  let activeIndex = -1;
  let filtered = [];
  let loginPayload = null;

  function getCookieValue(name) {
    const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
    return match ? match[1] : null;
  }

  function getLoginPayload() {
    try {
      const raw = localStorage.getItem("token") || getCookieValue("token");
      if (!raw) return null;
      const part = raw.split('.')[1];
      return JSON.parse(atob(part.replace(/-/g, '+').replace(/_/g, '/')));
    } catch { return null; }
  }

  function hasAccess(item, payload) {
    if (item.isLogin && !payload) return false;
    if (item.isBKN && !payload?.pegawai?.isBKN) return false;
    if (!payload) return true;
    if (!item.roles || item.roles.includes("*")) return true;
    return (payload.roles || []).some(r =>
      item.roles.some(menuRole => r.role.includes(menuRole))
    );
  }

  function buildUrl(item) {
    if (item.isLocal) return item.url;
    return `/run?app=${encodeURIComponent(item.url)}&isInternal=${item.isInternal}&isLocal=${item.isLocal}`;
  }

  function open() {
    loginPayload = getLoginPayload();
    overlay.classList.remove("hidden");
    requestAnimationFrame(() => {
      backdrop.classList.add("opacity-100");
      card.classList.remove("translate-y-[-16px]", "opacity-0");
      card.classList.add("translate-y-0", "opacity-100");
    });
    setTimeout(() => input.focus(), 50);
    renderResults("");
  }

  function close() {
    backdrop.classList.remove("opacity-100");
    card.classList.add("translate-y-[-16px]", "opacity-0");
    card.classList.remove("translate-y-0", "opacity-100");
    setTimeout(() => {
      overlay.classList.add("hidden");
      input.value = "";
      activeIndex = -1;
    }, 200);
  }

  function renderResults(query) {
    const q = query.toLowerCase().trim();
    const accessible = searchData.filter(item => hasAccess(item, loginPayload));
    filtered = q
      ? accessible.filter(
          (item) =>
            item.name.toLowerCase().includes(q) ||
            item.desc.toLowerCase().includes(q) ||
            item.category.toLowerCase().includes(q)
        )
      : accessible.slice(0, 12);

    activeIndex = filtered.length > 0 ? 0 : -1;
    renderList();
  }

  function renderList() {
    resultsList.innerHTML = "";

    if (filtered.length === 0) {
      emptyState.classList.remove("hidden");
      return;
    }
    emptyState.classList.add("hidden");

    filtered.forEach((item, idx) => {
      const li = document.createElement("li");
      li.className =
        "flex items-center gap-3 px-4 py-3 cursor-pointer transition-colors duration-100 " +
        (idx === activeIndex ? "bg-[#269DD8]/8" : "hover:bg-gray-50");
      li.dataset.index = String(idx);

      li.innerHTML = `
        <div class="flex-shrink-0 size-9 rounded-xl bg-[#DF2463]/8 flex items-center justify-center text-[#DF2463]">
          ${item.iconSvg}
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-sm font-semibold text-gray-800 truncate">${item.name}</div>
          <div class="text-[11px] text-gray-400 truncate mt-0.5">${item.desc}</div>
        </div>
        <span class="hidden sm:inline-flex flex-shrink-0 text-[10px] text-[#269DD8] bg-[#269DD8]/8 px-2 py-0.5 rounded-full font-medium">${item.category}</span>
      `;

      li.addEventListener("click", () => {
        window.location.href = buildUrl(item);
        close();
      });

      li.addEventListener("mouseenter", () => {
        activeIndex = idx;
        highlightActive();
      });

      resultsList.appendChild(li);
    });
  }

  function highlightActive() {
    const items = resultsList.querySelectorAll("li");
    items.forEach((li, idx) => {
      if (idx === activeIndex) {
        li.classList.add("bg-[#269DD8]/8");
        li.classList.remove("hover:bg-gray-50");
        li.scrollIntoView({ block: "nearest" });
      } else {
        li.classList.remove("bg-[#269DD8]/8");
        li.classList.add("hover:bg-gray-50");
      }
    });
  }

  // Keyboard: "/" to open
  document.addEventListener("keydown", (e) => {
    const tag = document.activeElement?.tagName;
    const isTyping = ["INPUT", "TEXTAREA", "SELECT"].includes(tag) || document.activeElement?.isContentEditable;

    if (e.key === "/" && !isTyping && overlay.classList.contains("hidden")) {
      e.preventDefault();
      open();
      return;
    }

    if (overlay.classList.contains("hidden")) return;

    if (e.key === "Escape") {
      close();
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      activeIndex = Math.min(activeIndex + 1, filtered.length - 1);
      highlightActive();
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      activeIndex = Math.max(activeIndex - 1, 0);
      highlightActive();
    } else if (e.key === "Enter" && activeIndex >= 0 && filtered[activeIndex]) {
      window.location.href = buildUrl(filtered[activeIndex]);
      close();
    }
  });

  input.addEventListener("input", (e) => {
    renderResults(e.target.value);
  });

